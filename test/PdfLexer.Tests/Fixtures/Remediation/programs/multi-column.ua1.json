      }
    },
    {
      "id": "page-footer",
      "target": {
        "artifact": "page-footer"
      },
      "candidates": {
        "kind": "text",
        "granularity": "Line"
      },
      "predicate": {
        "kind": "textStartsWith",
        "text": "Page "
