{
  "schema": "pdflexer.remediation.program.preview1",
  "id": "multi-column",
  "template": {
    "id": "multi-column",
    "version": "1",
    "profile": "PdfUa1",
    "document": {
      "tag": "Document",
      "children": [
        {
          "tag": "H1",
          "name": "title",
          "children": []
